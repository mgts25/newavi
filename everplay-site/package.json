{
  "name": "everplay-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i src/css/tailwind.css -o src/css/style.css --minify",
    "build": "npm run build:css && eleventy",
    "start": "npm run build:css && eleventy --serve",
    "watch:css": "tailwindcss -i src/css/tailwind.css -o src/css/style.css --watch"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "tailwindcss": "^3.4.13"
  }
}
