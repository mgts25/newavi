---
layout: base.njk
title: About Us | MULTIVERSE
activeNav: about
permalink: /about/
---
<main class="pt-36 pb-section_padding">

<section class="mx-auto px-gutter max-w-container_max_width">
<div class="game-grid">
{% for badge in team.badges %}
<div class="card-in" style="animation-delay: {{ loop.index0 * 80 }}ms;">
<div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container-high game-card-shadow game-card-frame transition-all duration-300" style="border-top: 3px solid {{ badge.accent | accentHex }};">
<div class="coming-soon-tile w-full h-full flex flex-col items-center justify-center gap-3 px-2 text-center" style="background: linear-gradient(145deg, {{ badge.accent | accentHex }}22, {{ badge.accent | accentHex }}0a);">
<span class="material-symbols-outlined text-[32px]" style="color: {{ badge.accent | accentHex }}; font-variation-settings: 'FILL' 1;">{{ badge.icon }}</span>
<span class="font-bold text-on-surface text-[13px] leading-tight">{{ badge.label }}</span>
</div>
</div>
</div>
{% endfor %}
</div>
</section>

<section class="py-section_padding">
<div class="mx-auto px-gutter max-w-container_max_width">
<div class="game-grid">
{% set memberAccents = ["primary", "tertiary", "secondary", "primary-container", "tertiary-container"] %}
{% for member in team.members %}
<div class="group flex flex-col gap-2 cursor-pointer card-in" style="animation-delay: {{ loop.index0 * 80 }}ms;" data-open-member="{{ loop.index0 }}">
<div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container-high game-card-shadow game-card-frame transition-all duration-300" style="border-top: 3px solid {{ memberAccents[loop.index0 % 5] | accentHex }};">
<img alt="{{ member.name }}" class="w-full h-full object-cover" src="{{ member.photo }}">
{% if member.linkedin %}
<a href="{{ member.linkedin }}" target="_blank" rel="noopener" onclick="event.stopPropagation()" class="absolute bottom-2 left-2 w-6 h-6 rounded bg-surface/90 flex items-center justify-center shadow-sm">
<svg width="12" height="12" viewBox="0 0 24 24" fill="#0a66c2"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
</a>
{% endif %}
</div>
<div class="flex flex-col leading-tight">
<h4 class="font-bold text-on-surface text-[13px] truncate">{{ member.name }}</h4>
<p class="text-secondary text-[11px]">{{ member.role }}</p>
</div>
</div>
{% endfor %}
</div>
</div>
</section>

<section class="py-section_padding">
<div class="mx-auto px-gutter max-w-container_max_width">
<div class="relative">
<div class="about-timeline-rail absolute left-0 right-0 top-6 h-0.5 bg-outline-variant/30 hidden md:block"></div>
<div class="about-timeline-scroll flex md:justify-between items-start gap-7 md:gap-2 overflow-x-auto md:overflow-visible pb-3 md:pb-0 -mx-gutter px-gutter md:mx-0 md:px-0">
{% for item in team.timeline %}
<button type="button" class="about-timeline-node flex-shrink-0 flex flex-col items-center gap-2 relative z-10 card-in" style="animation-delay: {{ loop.index0 * 60 }}ms;" data-open-timeline="{{ loop.index0 }}" aria-label="{{ item.title }}">
<span class="about-timeline-dot w-12 h-12 rounded-full flex items-center justify-center shadow-sm" style="background: {{ item.accent | accentHex }};">
<span class="material-symbols-outlined {{ item.accent | accentText }} text-[20px]" style="font-variation-settings: 'FILL' 1;">{{ item.icon }}</span>
</span>
<span class="font-label-md text-[11px] font-bold text-on-surface-variant">{{ item.year }}</span>
</button>
{% endfor %}
</div>
</div>
</div>
</section>

<section class="py-section_padding">
<div class="mx-auto px-gutter max-w-container_max_width text-center">
<div class="bg-primary/5 rounded-[32px] p-10 md:p-14">
<h2 class="font-headline-lg text-headline-lg mb-3">{{ team.ctaHeading }}</h2>
<p class="text-secondary font-body-md mb-8">{{ team.ctaBody }}</p>
<div class="flex flex-col sm:flex-row gap-4 justify-center">
<button type="button" data-open-newsletter class="bg-primary text-on-primary font-label-md text-label-md px-10 py-4 rounded-full hover:scale-105 active:scale-95 transition-all shadow-lg">Register to Newsletter</button>
<button type="button" data-open-contact class="border-2 border-primary text-primary font-label-md text-label-md px-10 py-4 rounded-full hover:bg-primary/5 transition-all">Contact Us</button>
</div>
</div>
</div>
</section>

</main>

<div id="member-modal" class="modal-backdrop" onclick="if(event.target===this) closeModal('member-modal')">
<div class="modal-panel bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-md mx-4 p-8 relative text-center" onclick="event.stopPropagation()">
<button type="button" onclick="closeModal('member-modal')" aria-label="Close" class="absolute top-4 right-4 text-on-surface-variant hover:text-primary transition-colors">
<span class="material-symbols-outlined">close</span>
</button>
<div class="w-24 h-24 rounded-full mx-auto mb-5 overflow-hidden bg-surface-container-highest">
<img id="md-photo" class="w-full h-full object-cover" src="" alt="">
</div>
<h3 id="md-name" class="font-headline-md text-headline-md text-on-surface mb-1"></h3>
<p id="md-role" class="text-primary font-label-md mb-4"></p>
<p id="md-bio" class="text-on-surface-variant text-sm font-body-md"></p>
</div>
</div>

<div id="timeline-modal" class="modal-backdrop" onclick="if(event.target===this) closeModal('timeline-modal')">
<div class="modal-panel bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-lg mx-4 relative overflow-hidden" onclick="event.stopPropagation()">
<button type="button" onclick="closeModal('timeline-modal')" aria-label="Close" class="absolute top-4 right-4 z-10 text-white bg-black/30 hover:bg-black/50 transition-colors rounded-full w-8 h-8 flex items-center justify-center">
<span class="material-symbols-outlined text-[18px]">close</span>
</button>
<div id="tm-video-wrap" class="w-full aspect-video bg-black hidden">
<video id="tm-video" class="w-full h-full object-contain bg-black" controls playsinline></video>
</div>
<div id="tm-placeholder-wrap" class="w-full aspect-video flex items-center justify-center hidden">
<span id="tm-placeholder-icon" class="material-symbols-outlined text-[56px]" style="font-variation-settings: 'FILL' 1;"></span>
</div>
<div class="p-8">
<div class="flex items-center gap-2 mb-3">
<span id="tm-year" class="font-label-md text-[11px] font-bold text-on-surface-variant"></span>
<span id="tm-genre" class="font-label-md text-[10px] uppercase tracking-wide px-2.5 py-1 rounded-full"></span>
</div>
<h3 id="tm-title" class="font-headline-md text-headline-md text-on-surface mb-3"></h3>
<p id="tm-description" class="text-secondary font-body-md text-[14px]"></p>
</div>
</div>
</div>

<script>
(function () {
    var MEMBERS = [
    {% for member in team.members %}
    {
        name: {{ member.name | dump | safe }},
        role: {{ member.role | dump | safe }},
        bio: {{ member.bio | dump | safe }},
        photo: {{ member.photo | dump | safe }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
    ];

    document.querySelectorAll('[data-open-member]').forEach(function (el) {
        el.addEventListener('click', function () {
            var m = MEMBERS[parseInt(el.getAttribute('data-open-member'), 10)];
            document.getElementById('md-photo').src = m.photo;
            document.getElementById('md-photo').alt = m.name;
            document.getElementById('md-name').textContent = m.name;
            document.getElementById('md-role').textContent = m.role;
            document.getElementById('md-bio').textContent = m.bio;
            window.openModal('member-modal');
        });
    });

    var TIMELINE = [
    {% for item in team.timeline %}
    {
        year: {{ item.year | dump | safe }},
        title: {{ item.title | dump | safe }},
        genre: {{ item.genre | dump | safe }},
        description: {{ item.description | dump | safe }},
        icon: {{ item.icon | dump | safe }},
        accentHex: {{ item.accent | accentHex | dump | safe }},
        video: {{ item.video | dump | safe }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
    ];

    var tmVideoWrap = document.getElementById('tm-video-wrap');
    var tmVideo = document.getElementById('tm-video');
    var tmPlaceholderWrap = document.getElementById('tm-placeholder-wrap');
    var tmPlaceholderIcon = document.getElementById('tm-placeholder-icon');
    var tmYear = document.getElementById('tm-year');
    var tmGenre = document.getElementById('tm-genre');
    var tmTitle = document.getElementById('tm-title');
    var tmDescription = document.getElementById('tm-description');

    document.querySelectorAll('[data-open-timeline]').forEach(function (el) {
        el.addEventListener('click', function () {
            var t = TIMELINE[parseInt(el.getAttribute('data-open-timeline'), 10)];
            tmYear.textContent = t.year;
            tmGenre.textContent = t.genre;
            tmGenre.style.background = t.accentHex + '1f';
            tmGenre.style.color = t.accentHex;
            tmTitle.textContent = t.title;
            tmDescription.textContent = t.description;

            if (t.video) {
                tmVideo.src = t.video;
                tmVideoWrap.classList.remove('hidden');
                tmPlaceholderWrap.classList.add('hidden');
            } else {
                tmVideo.removeAttribute('src');
                tmVideoWrap.classList.add('hidden');
                tmPlaceholderWrap.classList.remove('hidden');
                tmPlaceholderWrap.style.background = 'linear-gradient(145deg, ' + t.accentHex + '22, ' + t.accentHex + '0a)';
                tmPlaceholderIcon.textContent = t.icon;
                tmPlaceholderIcon.style.color = t.accentHex;
            }
            window.openModal('timeline-modal');
        });
    });

    var timelineModal = document.getElementById('timeline-modal');
    if (timelineModal && tmVideo && window.MutationObserver) {
        new MutationObserver(function () {
            if (!timelineModal.classList.contains('open')) {
                tmVideo.pause();
            }
        }).observe(timelineModal, { attributes: true, attributeFilter: ['class'] });
    }
})();
</script>
