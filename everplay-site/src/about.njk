---
layout: base.njk
title: About Us | MULTIVERSE
activeNav: about
permalink: /about/
---
<main class="pt-36 pb-section_padding">

{% if team.heroHeading and (team.heroHeading | trim) %}
<section class="mx-auto px-gutter max-w-container_max_width text-center">
<div class="max-w-2xl mx-auto mb-12">
<h1 class="font-display-lg text-display-lg text-on-surface mb-3">{{ team.heroHeading }}</h1>
{% if team.heroSubtext and (team.heroSubtext | trim) %}
<p class="font-body-lg text-body-lg text-secondary">{{ team.heroSubtext }}</p>
{% endif %}
</div>
{% if team.stats and team.stats.length %}
<div class="flex flex-wrap justify-center gap-4 md:gap-6 mb-4">
{% for stat in team.stats %}
<div class="about-stat-tile rounded-lg bg-surface-container-high px-8 py-5 min-w-[150px] card-in" style="animation-delay: {{ loop.index0 * 80 }}ms;">
<div class="font-headline-lg text-headline-lg text-primary">{{ stat.value }}</div>
<div class="font-label-md text-[11px] uppercase tracking-wide text-on-surface-variant mt-1">{{ stat.label }}</div>
</div>
{% endfor %}
</div>
{% endif %}
</section>
{% endif %}

<section class="py-section_padding">
<div class="mx-auto px-gutter max-w-container_max_width">
<div class="text-center mb-10">
<span class="font-label-md text-[11px] tracking-widest uppercase text-primary">Meet the Team</span>
<h2 class="font-headline-lg text-headline-lg text-on-surface mt-2">The People Building MULTIVERSE</h2>
</div>
<div class="game-grid">
{% set memberAccents = ["primary", "tertiary", "secondary", "primary-container", "tertiary-container"] %}
{% for member in team.members %}
<div class="group flex flex-col gap-2 cursor-pointer card-in" style="animation-delay: {{ loop.index0 * 80 }}ms;" data-open-member="{{ loop.index0 }}">
<div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container-high game-card-shadow game-card-frame transition-all duration-300" style="border-top: 3px solid {{ memberAccents[loop.index0 % 5] | accentHex }};">
<img alt="{{ member.name }}" class="w-full h-full object-cover" src="{{ member.photo }}">
{% if member.linkedin %}
<a href="{{ member.linkedin }}" target="_blank" rel="noopener" onclick="event.stopPropagation()" class="absolute bottom-2 left-2 w-6 h-6 rounded bg-surface/90 flex items-center justify-center shadow-sm">
<svg width="12" height="12" viewBox="0 0 24 24" fill="#0a66c2"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
</a>
{% endif %}
</div>
<div class="flex flex-col leading-tight">
<h4 class="font-bold text-on-surface text-[13px] truncate">{{ member.name }}</h4>
<p class="text-secondary text-[11px]">{{ member.role }}</p>
</div>
</div>
{% endfor %}
</div>
</div>
</section>

<section class="py-section_padding">
<div class="mx-auto px-gutter max-w-container_max_width">
<div class="text-center mb-12">
<span class="font-label-md text-[11px] tracking-widest uppercase text-primary">Our Journey</span>
<h2 class="font-headline-lg text-headline-lg text-on-surface mt-2">From First Launch to MULTIVERSE</h2>
</div>
<div class="relative max-w-2xl mx-auto">
<div class="about-timeline-rail absolute left-5 md:left-6 top-2 bottom-2 w-0.5 bg-outline-variant/30"></div>
<div class="flex flex-col gap-8">
{% for item in team.timeline %}
<div class="flex gap-5 relative card-in" style="animation-delay: {{ loop.index0 * 80 }}ms;">
<div class="about-timeline-dot flex-shrink-0 w-10 h-10 md:w-12 md:h-12 rounded-full flex items-center justify-center relative z-10 shadow-sm" style="background: {{ item.accent | accentHex }};">
<span class="material-symbols-outlined {{ item.accent | accentText }} text-[18px] md:text-[20px]" style="font-variation-settings: 'FILL' 1;">{{ item.icon }}</span>
</div>
<div class="pt-1 pb-1">
<div class="flex items-center gap-2 mb-1">
<span class="font-label-md text-[11px] font-bold tracking-wide" style="color: {{ item.accent | accentHex }};">{{ item.year }}</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-1 leading-snug">{{ item.title }}</h3>
<p class="text-secondary font-body-md text-[14px]">{{ item.description }}</p>
</div>
</div>
{% endfor %}
</div>
</div>
</div>
</section>

<section class="py-section_padding">
<div class="mx-auto px-gutter max-w-container_max_width text-center">
<div class="bg-primary/5 rounded-[32px] p-12 md:p-20 relative overflow-hidden">
<span class="material-symbols-outlined text-primary/15 text-[120px] absolute -right-4 -top-4 pointer-events-none select-none" style="font-variation-settings: 'FILL' 1;">stadia_controller</span>
<h2 class="font-headline-lg text-headline-lg mb-6 relative">{{ team.ctaHeading }}</h2>
<p class="text-secondary max-w-xl mx-auto font-body-lg mb-10 relative">{{ team.ctaBody }}</p>
<div class="flex flex-col sm:flex-row gap-4 justify-center relative">
<button type="button" data-open-newsletter class="bg-primary text-on-primary font-label-md text-label-md px-10 py-4 rounded-full hover:scale-105 active:scale-95 transition-all shadow-lg">Register to Newsletter</button>
<button type="button" data-open-contact class="border-2 border-primary text-primary font-label-md text-label-md px-10 py-4 rounded-full hover:bg-primary/5 transition-all">Contact Us</button>
</div>
</div>
</div>
</section>

</main>

<div id="member-modal" class="modal-backdrop" onclick="if(event.target===this) closeModal('member-modal')">
<div class="modal-panel bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-md mx-4 p-8 relative text-center" onclick="event.stopPropagation()">
<button type="button" onclick="closeModal('member-modal')" aria-label="Close" class="absolute top-4 right-4 text-on-surface-variant hover:text-primary transition-colors">
<span class="material-symbols-outlined">close</span>
</button>
<div class="w-24 h-24 rounded-full mx-auto mb-5 overflow-hidden bg-surface-container-highest">
<img id="md-photo" class="w-full h-full object-cover" src="" alt="">
</div>
<h3 id="md-name" class="font-headline-md text-headline-md text-on-surface mb-1"></h3>
<p id="md-role" class="text-primary font-label-md mb-4"></p>
<p id="md-bio" class="text-on-surface-variant text-sm font-body-md"></p>
</div>
</div>

<script>
(function () {
    var MEMBERS = [
    {% for member in team.members %}
    {
        name: {{ member.name | dump | safe }},
        role: {{ member.role | dump | safe }},
        bio: {{ member.bio | dump | safe }},
        photo: {{ member.photo | dump | safe }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
    ];

    document.querySelectorAll('[data-open-member]').forEach(function (el) {
        el.addEventListener('click', function () {
            var m = MEMBERS[parseInt(el.getAttribute('data-open-member'), 10)];
            document.getElementById('md-photo').src = m.photo;
            document.getElementById('md-photo').alt = m.name;
            document.getElementById('md-name').textContent = m.name;
            document.getElementById('md-role').textContent = m.role;
            document.getElementById('md-bio').textContent = m.bio;
            window.openModal('member-modal');
        });
    });
})();
</script>
