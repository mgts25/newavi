---
layout: base.njk
title: About Us | Everplay
activeNav: about
permalink: /about/
---
<main class="pt-20 pb-section_padding mx-auto px-gutter max-w-container_max_width">
<section class="py-section_padding">
<div class="max-w-container_max_width mx-auto px-gutter">
<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
<div>
<span class="inline-block py-1 px-3 rounded-full bg-primary-container/10 text-primary font-label-md text-label-md mb-6">{{ team.heroTag }}</span>
<h2 class="font-display-lg text-display-lg text-on-surface mb-8">{{ team.heroHeading }}</h2>
<p class="font-body-lg text-body-lg text-secondary mb-8">{{ team.heroBody }}</p>
<div class="flex flex-wrap gap-4">
<button class="bg-primary text-on-primary font-label-md text-label-md px-8 py-4 rounded-lg hover:shadow-lg transition-all">Register to Newsletter</button>
<button class="border-2 border-primary text-primary font-label-md text-label-md px-8 py-4 rounded-lg hover:bg-primary/5 transition-all">Contact Us</button>
</div>
</div>
<div class="relative">
<div class="absolute -inset-4 bg-primary/5 rounded-[24px] blur-3xl -z-10"></div>
<img alt="{{ team.heroImageAlt }}" class="w-full rounded-[24px] shadow-xl object-cover aspect-video" src="{{ team.heroImage }}">
</div>
</div>
</div>
</section>
<section class="py-section_padding bg-surface-container-low">
<div class="max-w-container_max_width mx-auto px-gutter">
<div class="text-center mb-16">
<h2 class="font-headline-lg text-headline-lg mb-4">{{ team.teamHeading }}</h2>
<p class="text-secondary max-w-2xl mx-auto font-body-md">{{ team.teamSubtext }}</p>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
{% for member in team.members %}
<div class="bg-surface p-6 rounded-xl shadow-sm border border-outline-variant/30 text-center group hover:shadow-md transition-all">
<div class="w-24 h-24 bg-surface-container-highest rounded-full mx-auto mb-6 overflow-hidden">
<img alt="{{ member.name }}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" src="{{ member.photo }}">
</div>
<h3 class="font-headline-md text-headline-md mb-1">{{ member.name }}</h3>
<p class="text-primary font-label-md mb-4">{{ member.role }}</p>
<p class="text-on-surface-variant text-sm font-body-md">{{ member.bio }}</p>
</div>
{% endfor %}
</div>
</div>
</section>
<section class="py-section_padding">
<div class="max-w-container_max_width mx-auto px-gutter text-center">
<div class="bg-primary/5 rounded-[32px] p-12 md:p-20">
<h2 class="font-headline-lg text-headline-lg mb-6">{{ team.ctaHeading }}</h2>
<p class="text-secondary max-w-xl mx-auto font-body-lg mb-10">{{ team.ctaBody }}</p>
<div class="flex flex-col sm:flex-row gap-4 justify-center">
<button class="bg-primary text-on-primary font-label-md text-label-md px-10 py-4 rounded-full hover:scale-105 active:scale-95 transition-all shadow-lg">Register to Newsletter</button>
<button class="border-2 border-primary text-primary font-label-md text-label-md px-10 py-4 rounded-full hover:bg-primary/5 transition-all">Contact Us</button>
</div>
</div>
</div>
</section>
</main>
