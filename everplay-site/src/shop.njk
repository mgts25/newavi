---
layout: base.njk
title: MULTIVERSE | Verse Shop
activeNav: shop
permalink: /shop/
---
{% macro verseCoin(idSuffix, size) %}
<svg class="verse-coin" style="width:{{ size }}px;height:{{ size }}px;" viewBox="0 0 64 64" aria-hidden="true">
<defs>
<linearGradient id="verseFace-{{ idSuffix }}" x1="0%" y1="0%" x2="100%" y2="100%">
<stop offset="0%" stop-color="#ff5e9e"/>
<stop offset="45%" stop-color="#ff9a56"/>
<stop offset="100%" stop-color="#8b5cf6"/>
</linearGradient>
</defs>
<g class="verse-coin-ring">
<circle cx="32" cy="32" r="30" fill="none" stroke="url(#verseFace-{{ idSuffix }})" stroke-width="1.5" stroke-dasharray="4 5" opacity="0.6"/>
</g>
<circle cx="32" cy="32" r="24" fill="url(#verseFace-{{ idSuffix }})"/>
<circle cx="32" cy="32" r="24" fill="none" stroke="#ffffff" stroke-opacity="0.35" stroke-width="1.5"/>
<path d="M20 22 L32 44 L44 22" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
<circle cx="14" cy="48" r="2.5" fill="#feca57"/>
<polygon points="50,12 53,18 47,18" fill="#00d4ff" opacity="0.85"/>
</svg>
{% endmacro %}
<main class="pt-24 pb-section_padding">
<section class="mx-auto px-gutter max-w-container_max_width mb-12">
<div class="verse-hero rounded-[32px] px-8 py-12 md:py-16 text-center relative overflow-hidden">
<div class="verse-hero-glow"></div>
<div class="relative flex flex-col items-center">
<div class="mb-4 coin-float">{{ verseCoin("hero", 110) }}</div>
<h1 class="font-display-lg text-display-lg font-extrabold text-white mb-3 tracking-tight">VERSE</h1>
<p class="font-body-lg text-body-lg text-white/85 max-w-xl mx-auto">{{ verseShop.intro }}</p>
</div>
</div>
</section>
<section class="mx-auto px-gutter max-w-container_max_width w-full">
<div class="game-grid">
{% set packageAccents = ["primary", "tertiary", "secondary", "primary-container", "tertiary-container"] %}
{% for pkg in verseShop.packages %}
<div class="group flex flex-col gap-2 card-in" style="animation-delay: {{ loop.index0 * 90 }}ms;">
<div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden verse-card-face game-card-shadow game-card-frame transition-all duration-300" style="border-top: 3px solid {{ packageAccents[loop.index0 % 5] | accentHex }};">
{% if pkg.badge %}
<div class="absolute top-2 right-2 z-10 bg-primary text-on-primary px-2 py-0.5 rounded-full font-label-md text-[9px] uppercase font-bold tracking-widest shadow-sm">{{ pkg.badge }}</div>
{% endif %}
<div class="w-full h-full flex flex-col items-center justify-center gap-1 px-2">
{{ verseCoin("card-" + loop.index0, 56) }}
<span class="font-display-lg font-extrabold text-[20px] text-on-surface mt-1 leading-none">{{ pkg.totalVerse }}</span>
<span class="font-label-md text-[9px] tracking-widest uppercase text-secondary">VERSE</span>
{% if pkg.bonusAmount > 0 %}
<span class="font-label-md text-[9px] font-bold mt-0.5" style="color: {{ packageAccents[loop.index0 % 5] | accentHex }};">+{{ pkg.bonusAmount }} ({{ pkg.bonusPercent }}%) Bonus</span>
{% else %}
<span class="font-label-md text-[9px] text-on-surface-variant/50 mt-0.5">Starter Pack</span>
{% endif %}
</div>
</div>
<div class="flex flex-col items-center gap-2 text-center">
<p class="font-bold text-on-surface text-[14px]">{{ pkg.amount }} Verse — {{ pkg.price }}</p>
<a href="{{ pkg.buyLink }}" class="buy-now-btn w-full py-2 rounded-full text-center font-label-md text-[11px] font-bold uppercase tracking-wide text-white">Buy Now</a>
</div>
</div>
{% endfor %}
</div>
<p class="text-center text-on-surface-variant/60 text-[12px] mt-10">Secure checkout, one package per purchase — no cart needed.</p>
</section>
</main>
