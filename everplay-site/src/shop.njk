---
layout: base.njk
title: MULTIVERSE | Verse Shop
activeNav: shop
permalink: /shop/
---
<main class="pt-24 pb-section_padding">
<div class="mx-auto px-gutter max-w-container_max_width">

<div id="payment-success-banner" class="payment-banner hidden items-center gap-3 rounded-xl px-5 py-4 mb-8 bg-primary/10 border border-primary/30">
<span class="material-symbols-outlined text-primary text-[26px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
<div>
<p class="font-bold text-on-surface text-[14px]">Payment successful!</p>
<p class="text-secondary text-[12px]">Your Verse will be added to your account shortly. Thanks for the purchase.</p>
</div>
</div>

<div id="payment-cancelled-banner" class="payment-banner hidden items-center gap-3 rounded-xl px-5 py-4 mb-8 bg-surface-container-high border border-outline-variant">
<span class="material-symbols-outlined text-on-surface-variant text-[26px]">info</span>
<div>
<p class="font-bold text-on-surface text-[14px]">Payment cancelled</p>
<p class="text-secondary text-[12px]">No charge was made. Your cart is still saved whenever you're ready to try again.</p>
</div>
</div>

<div class="game-grid">
{% set packageAccents = ["primary", "tertiary", "secondary", "primary-container", "tertiary-container", "primary"] %}
{% for pkg in verseShop.packages %}
<div class="group flex flex-col gap-2 card-in" style="animation-delay: {{ loop.index0 * 80 }}ms;">
<div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container-high game-card-shadow game-card-frame transition-all duration-300" style="border-top: 3px solid {{ packageAccents[loop.index0 % 6] | accentHex }};">
{% if pkg.badge %}
<div class="absolute top-2 right-2 z-10 bg-primary text-on-primary px-2 py-0.5 rounded-full font-label-md text-[9px] uppercase font-bold tracking-widest shadow-sm">{{ pkg.badge }}</div>
{% endif %}
<div class="w-full h-full flex flex-col items-center justify-center gap-0.5 px-2 pt-2" style="background: linear-gradient(145deg, {{ packageAccents[loop.index0 % 6] | accentHex }}22, {{ packageAccents[loop.index0 % 6] | accentHex }}0a);">
<img src="{{ pkg.icon }}" alt="" class="w-[68%] max-h-[58%] object-contain">
<span class="font-display-lg font-extrabold text-[20px] text-on-surface leading-none">{{ pkg.totalVerse }}</span>
<span class="font-label-md text-[9px] tracking-widest uppercase text-secondary">VERSE</span>
{% if pkg.bonusAmount > 0 %}
<span class="font-label-md text-[9px] font-bold mt-0.5" style="color: {{ packageAccents[loop.index0 % 6] | accentHex }};">+{{ pkg.bonusAmount }} ({{ pkg.bonusPercent }}%) Bonus</span>
{% else %}
<span class="font-label-md text-[9px] text-on-surface-variant/50 mt-0.5">Starter Pack</span>
{% endif %}
</div>
</div>
<button type="button"
    class="add-to-cart-btn w-full py-2.5 rounded-full text-center font-label-md text-[11px] font-bold uppercase tracking-wide transition-all {% if pkg.badge %}bg-primary text-on-primary hover:bg-primary-container shadow-sm{% else %}border border-primary text-primary hover:bg-primary/5{% endif %}"
    data-id="{{ pkg.id }}"
    data-name="{{ pkg.totalVerse }} Verse"
    data-price-cents="{{ pkg.priceCents }}"
    data-price-label="{{ pkg.price }}"
    data-icon="{{ pkg.icon }}">
Add to Cart — {{ pkg.price }}
</button>
</div>
{% endfor %}
</div>

</div>
</main>

<!-- ===== Cart floating action button ===== -->
<button type="button" id="cart-fab" onclick="window.openCart()" aria-label="Open cart" class="cart-fab w-14 h-14 rounded-full bg-primary text-on-primary flex items-center justify-center">
<span class="material-symbols-outlined text-[24px]">shopping_cart</span>
<span id="cart-fab-badge" class="cart-fab-badge bg-error text-on-error font-bold text-[11px]">0</span>
</button>

<!-- ===== Cart drawer ===== -->
<div id="cart-drawer-backdrop" class="modal-backdrop cart-drawer-backdrop" onclick="if(event.target===this) closeCart()">
<div class="modal-panel cart-drawer-panel bg-surface-container-lowest shadow-2xl flex flex-col" onclick="event.stopPropagation()">
<div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant/30 flex-shrink-0">
<h3 class="font-headline-md text-headline-md text-on-surface">Your Cart</h3>
<button type="button" onclick="closeCart()" aria-label="Close" class="text-on-surface-variant hover:text-primary transition-colors">
<span class="material-symbols-outlined">close</span>
</button>
</div>

<div id="cart-items" class="flex-1 overflow-y-auto px-6 py-4 space-y-4"></div>

<div id="cart-empty-state" class="hidden flex-1 flex flex-col items-center justify-center gap-3 text-center px-6">
<span class="material-symbols-outlined text-on-surface-variant/40 text-[48px]">shopping_cart</span>
<p class="text-secondary text-[13px]">Your cart is empty.</p>
<button type="button" onclick="closeCart()" class="font-label-md text-label-md text-primary hover:underline">Browse Verse packages</button>
</div>

<div id="cart-footer" class="px-6 py-5 border-t border-outline-variant/30 flex-shrink-0 space-y-4">
<div class="flex items-center justify-between">
<span class="font-label-md text-label-md text-on-surface-variant">Total</span>
<span id="cart-total" class="font-headline-md text-headline-md text-on-surface">$0.00</span>
</div>
<button type="button" id="checkout-btn" onclick="startCheckout()" class="w-full py-3.5 rounded-full bg-primary text-on-primary font-label-md text-label-md font-bold hover:bg-primary-container hover:text-on-primary-container transition-all shadow-sm disabled:opacity-60 disabled:cursor-not-allowed">
Proceed to Payment
</button>
<p id="checkout-error" class="hidden text-center text-[12px] text-error">Something went wrong starting checkout — please try again.</p>
<p class="text-center text-[11px] text-on-surface-variant/60">Secure checkout powered by Stripe.</p>
</div>
</div>
</div>

<!-- ===== Cart item row template ===== -->
<template id="cart-item-template">
<div class="cart-row flex items-center gap-3">
<img class="cart-row-icon w-12 h-12 object-contain rounded-lg bg-surface-container-high p-1" src="" alt="">
<div class="flex-1 min-w-0">
<p class="cart-row-name font-bold text-on-surface text-[13px] truncate"></p>
<p class="cart-row-unit-price text-secondary text-[11px]"></p>
</div>
<div class="flex items-center gap-2">
<button type="button" class="qty-stepper-btn qty-decrement bg-surface-container-high hover:bg-surface-container-highest">
<span class="material-symbols-outlined text-[14px]">remove</span>
</button>
<span class="cart-row-qty text-[13px] font-bold w-4 text-center"></span>
<button type="button" class="qty-stepper-btn qty-increment bg-surface-container-high hover:bg-surface-container-highest">
<span class="material-symbols-outlined text-[14px]">add</span>
</button>
</div>
<button type="button" class="qty-remove text-on-surface-variant/50 hover:text-error transition-colors" aria-label="Remove">
<span class="material-symbols-outlined text-[18px]">delete</span>
</button>
</div>
</template>

<script>
(function () {
    var CART_KEY = 'multiverse_verse_cart';

    function loadCart() {
        try {
            var raw = localStorage.getItem(CART_KEY);
            return raw ? JSON.parse(raw) : [];
        } catch (e) { return []; }
    }
    function saveCart(cart) {
        try { localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch (e) {}
    }

    var cart = loadCart();

    function formatDollars(cents) {
        return '$' + (cents / 100).toFixed(2);
    }

    function cartTotalCents() {
        return cart.reduce(function (sum, item) { return sum + item.priceCents * item.qty; }, 0);
    }
    function cartCount() {
        return cart.reduce(function (sum, item) { return sum + item.qty; }, 0);
    }

    function render() {
        var itemsWrap = document.getElementById('cart-items');
        var emptyState = document.getElementById('cart-empty-state');
        var footer = document.getElementById('cart-footer');
        var badge = document.getElementById('cart-fab-badge');
        var template = document.getElementById('cart-item-template');

        itemsWrap.innerHTML = '';

        if (cart.length === 0) {
            itemsWrap.classList.add('hidden');
            footer.classList.add('hidden');
            emptyState.classList.remove('hidden');
        } else {
            itemsWrap.classList.remove('hidden');
            footer.classList.remove('hidden');
            emptyState.classList.add('hidden');

            cart.forEach(function (item) {
                var row = template.content.cloneNode(true);
                row.querySelector('.cart-row-icon').src = item.icon;
                row.querySelector('.cart-row-name').textContent = item.name;
                row.querySelector('.cart-row-unit-price').textContent = item.priceLabel + ' each';
                row.querySelector('.cart-row-qty').textContent = item.qty;
                row.querySelector('.qty-decrement').addEventListener('click', function () { changeQty(item.id, -1); });
                row.querySelector('.qty-increment').addEventListener('click', function () { changeQty(item.id, 1); });
                row.querySelector('.qty-remove').addEventListener('click', function () { removeItem(item.id); });
                itemsWrap.appendChild(row);
            });
        }

        document.getElementById('cart-total').textContent = formatDollars(cartTotalCents());

        var count = cartCount();
        badge.textContent = count;
        badge.classList.toggle('show', count > 0);

        saveCart(cart);
    }

    function addToCart(data) {
        var existing = cart.find(function (i) { return i.id === data.id; });
        if (existing) {
            existing.qty += 1;
        } else {
            cart.push({ id: data.id, name: data.name, priceCents: data.priceCents, priceLabel: data.priceLabel, icon: data.icon, qty: 1 });
        }
        render();
        window.openCart();
    }

    function changeQty(id, delta) {
        var item = cart.find(function (i) { return i.id === id; });
        if (!item) return;
        item.qty += delta;
        if (item.qty <= 0) {
            cart = cart.filter(function (i) { return i.id !== id; });
        }
        render();
    }

    function removeItem(id) {
        cart = cart.filter(function (i) { return i.id !== id; });
        render();
    }

    window.openCart = function () {
        document.getElementById('cart-drawer-backdrop').classList.add('open');
        document.body.style.overflow = 'hidden';
    };
    window.closeCart = function () {
        document.getElementById('cart-drawer-backdrop').classList.remove('open');
        document.body.style.overflow = '';
    };

    document.querySelectorAll('.add-to-cart-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            addToCart({
                id: btn.dataset.id,
                name: btn.dataset.name,
                priceCents: parseInt(btn.dataset.priceCents, 10),
                priceLabel: btn.dataset.priceLabel,
                icon: btn.dataset.icon
            });
        });
    });

    window.startCheckout = function () {
        if (cart.length === 0) return;
        var btn = document.getElementById('checkout-btn');
        var errorEl = document.getElementById('checkout-error');
        errorEl.classList.add('hidden');
        btn.disabled = true;
        btn.textContent = 'Redirecting…';

        fetch('/.netlify/functions/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                items: cart.map(function (i) { return { name: i.name, priceCents: i.priceCents, qty: i.qty }; })
            })
        }).then(function (res) {
            if (!res.ok) throw new Error('checkout failed');
            return res.json();
        }).then(function (data) {
            if (!data.url) throw new Error('no checkout url');
            window.location.href = data.url;
        }).catch(function () {
            btn.disabled = false;
            btn.textContent = 'Proceed to Payment';
            errorEl.classList.remove('hidden');
        });
    };

    // ----- Payment confirmation banners from Stripe redirect -----
    var params = new URLSearchParams(window.location.search);
    if (params.get('payment') === 'success') {
        document.getElementById('payment-success-banner').classList.remove('hidden');
        document.getElementById('payment-success-banner').classList.add('flex');
        cart = [];
        saveCart(cart);
    } else if (params.get('payment') === 'cancelled') {
        document.getElementById('payment-cancelled-banner').classList.remove('hidden');
        document.getElementById('payment-cancelled-banner').classList.add('flex');
    }

    render();
})();
</script>
