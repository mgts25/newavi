---
layout: base.njk
title: MULTIVERSE | Verse Shop
activeNav: shop
permalink: /shop/
---
<main class="pt-24 pb-section_padding">
<div class="mx-auto px-gutter max-w-container_max_width">
<div class="mb-8">
<span class="inline-block py-1 px-3 rounded-full bg-primary-container/10 text-primary font-label-md text-label-md mb-4">In-Game Currency</span>
<h1 class="font-display-lg text-display-lg text-on-surface mb-3">VERSE</h1>
<p class="font-body-lg text-body-lg text-secondary max-w-2xl">{{ verseShop.intro }}</p>
</div>
<div class="game-grid">
{% set packageAccents = ["primary", "tertiary", "secondary", "primary-container", "tertiary-container", "primary"] %}
{% for pkg in verseShop.packages %}
<div class="group flex flex-col gap-2 card-in" style="animation-delay: {{ loop.index0 * 80 }}ms;">
<div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container-high game-card-shadow game-card-frame transition-all duration-300" style="border-top: 3px solid {{ packageAccents[loop.index0 % 6] | accentHex }};">
{% if pkg.badge %}
<div class="absolute top-2 right-2 z-10 bg-primary text-on-primary px-2 py-0.5 rounded-full font-label-md text-[9px] uppercase font-bold tracking-widest shadow-sm">{{ pkg.badge }}</div>
{% endif %}
<div class="w-full h-full flex flex-col items-center justify-center gap-1.5 px-2" style="background: linear-gradient(145deg, {{ packageAccents[loop.index0 % 6] | accentHex }}22, {{ packageAccents[loop.index0 % 6] | accentHex }}0a);">
<span class="material-symbols-outlined text-[34px]" style="color: {{ packageAccents[loop.index0 % 6] | accentHex }}; font-variation-settings: 'FILL' 1;">toll</span>
<span class="font-display-lg font-extrabold text-[20px] text-on-surface mt-1 leading-none">{{ pkg.totalVerse }}</span>
<span class="font-label-md text-[9px] tracking-widest uppercase text-secondary">VERSE</span>
{% if pkg.bonusAmount > 0 %}
<span class="font-label-md text-[9px] font-bold mt-0.5" style="color: {{ packageAccents[loop.index0 % 6] | accentHex }};">+{{ pkg.bonusAmount }} ({{ pkg.bonusPercent }}%) Bonus</span>
{% else %}
<span class="font-label-md text-[9px] text-on-surface-variant/50 mt-0.5">Starter Pack</span>
{% endif %}
</div>
</div>
<div class="flex flex-col items-center gap-2 text-center">
<p class="font-bold text-on-surface text-[14px]">{{ pkg.amount }} Verse — {{ pkg.price }}</p>
<a href="{{ pkg.buyLink }}" class="w-full py-2.5 rounded-full text-center font-label-md text-[11px] font-bold uppercase tracking-wide transition-all {% if pkg.badge %}bg-primary text-on-primary hover:bg-primary-container shadow-sm{% else %}border border-primary text-primary hover:bg-primary/5{% endif %}">Buy Now</a>
</div>
</div>
{% endfor %}
</div>
<p class="text-center text-on-surface-variant/60 text-[12px] mt-10">Secure checkout, one package per purchase — no cart needed.</p>
</div>
</main>
