---
layout: base.njk
title: MULTIVERSE | Game Library
activeNav: home
permalink: /
---
<main class="pt-36 pb-section_padding">
<div class="mx-auto px-gutter max-w-container_max_width">
{% if home.heading and (home.heading | trim) %}
<div class="mb-8">
<h1 class="font-display-lg text-display-lg text-on-surface mb-3">{{ home.heading }}</h1>
{% if home.subtext and (home.subtext | trim) %}
<p class="font-body-lg text-body-lg text-secondary max-w-2xl">{{ home.subtext }}</p>
{% endif %}
</div>
{% endif %}
<div class="game-grid">
{% for game in games %}
<div class="group flex flex-col gap-2 card-in" style="animation-delay: {{ loop.index0 * 80 }}ms;">
<div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container-high game-card-shadow game-card-frame transition-all duration-300" style="border-top: 3px solid {{ game.accent | accentHex }};">
{% if game.comingSoon or (not game.image and not game.video) %}
<div class="coming-soon-tile w-full h-full flex flex-col items-center justify-center gap-3" style="background: linear-gradient(145deg, {{ game.accent | accentHex }}22, {{ game.accent | accentHex }}0a);">
<span class="material-symbols-outlined text-[36px]" style="color: {{ game.accent | accentHex }}; font-variation-settings: 'FILL' 1;">{{ game.icon }}</span>
<span class="font-label-md text-[10px] tracking-widest uppercase" style="color: {{ game.accent | accentHex }};">Coming Soon</span>
</div>
{% else %}
{% if game.image %}
<div class="static-thumb w-full h-full bg-cover bg-center" style="background-image: url('{{ game.image }}');"></div>
{% if game.video %}
<div class="video-container absolute inset-0">
<video class="w-full h-full object-cover" loop muted playsinline>
<source src="{{ game.video }}" type="video/mp4">
</video>
</div>
{% endif %}
{% else %}
<video class="w-full h-full object-cover" loop muted playsinline>
<source src="{{ game.video }}" type="video/mp4">
</video>
{% endif %}
{% if game.logo %}
<div class="game-logo-overlay absolute inset-x-0 bottom-0 pt-8 pb-2 px-2 flex items-end justify-center pointer-events-none" style="background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);">
<img src="{{ game.logo }}" alt="">
</div>
{% else %}
<div class="game-logo-overlay absolute bottom-2 left-2 w-6 h-6 rounded {{ game.accent | accentBadge }} flex items-center justify-center shadow-sm">
<span class="material-symbols-outlined {{ game.accent | accentText }} text-[14px]">{{ game.icon }}</span>
</div>
{% endif %}
{% endif %}
</div>
<div class="flex flex-col leading-tight">
<h4 class="font-bold text-on-surface text-[13px] truncate">{{ game.title }}</h4>
<p class="text-secondary text-[11px]">{{ game.genre }}</p>
<p class="text-on-surface-variant font-medium text-[11px]">{{ game.price }}</p>
</div>
</div>
{% endfor %}
</div>
</div>
</main>
<script>
    // Game cards with both a cover image AND a video: show the cover as a
    // banner first, then swap over to the looping gameplay video after a
    // short delay, once the card is actually on screen. Cards with no cover
    // image (continuous-loop tiles) have nothing to show first, so those
    // just play right away. Either way, scrolling a card out of view pauses
    // its video (and, for the banner cards, resets back to the cover image)
    // so the whole sequence replays next time it scrolls back in — and so
    // the page isn't decoding video for cards no one is looking at.
    const BANNER_DELAY_MS = 5000;
    const pendingTimers = new WeakMap();

    const bannerCards = [];
    const plainVideos = [];
    document.querySelectorAll('.group').forEach((card) => {
        const container = card.querySelector('.video-container');
        const video = card.querySelector('video');
        if (!video) return;
        if (container) {
            bannerCards.push({ card, container, video });
        } else {
            plainVideos.push(video);
        }
    });

    const bannerObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            const card = entry.target;
            const video = card.querySelector('video');
            if (entry.isIntersecting) {
                const timer = setTimeout(() => {
                    card.classList.add('video-active');
                    video.currentTime = 0;
                    video.play().catch(() => {});
                }, BANNER_DELAY_MS);
                pendingTimers.set(card, timer);
            } else {
                clearTimeout(pendingTimers.get(card));
                pendingTimers.delete(card);
                card.classList.remove('video-active');
                video.pause();
                video.currentTime = 0;
            }
        });
    }, { threshold: 0.25 });

    bannerCards.forEach(({ card }) => bannerObserver.observe(card));

    const plainVideoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            const video = entry.target;
            if (entry.isIntersecting) {
                video.play().catch(() => {});
            } else {
                video.pause();
            }
        });
    }, { threshold: 0.25 });

    plainVideos.forEach((video) => plainVideoObserver.observe(video));
</script>
