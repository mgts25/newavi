---
layout: base.njk
title: MULTIVERSE | Game Library
activeNav: home
permalink: /
---
<main class="pt-24 pb-section_padding">
<div class="mx-auto px-gutter max-w-container_max_width">
<div class="mb-8">
<h1 class="font-display-lg text-display-lg text-on-surface mb-3">{{ home.heading }}</h1>
<p class="font-body-lg text-body-lg text-secondary max-w-2xl">{{ home.subtext }}</p>
</div>
<div class="game-grid">
{% for game in games %}
<div class="group flex flex-col gap-2">
<div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container-high game-card-shadow game-card-frame transition-all duration-300" style="border-top: 3px solid {{ game.accent | accentHex }};">
{% if game.comingSoon or not game.image %}
<div class="coming-soon-tile w-full h-full flex flex-col items-center justify-center gap-3" style="background: linear-gradient(145deg, {{ game.accent | accentHex }}22, {{ game.accent | accentHex }}0a);">
<span class="material-symbols-outlined text-[36px]" style="color: {{ game.accent | accentHex }}; font-variation-settings: 'FILL' 1;">{{ game.icon }}</span>
<span class="font-label-md text-[10px] tracking-widest uppercase" style="color: {{ game.accent | accentHex }};">Coming Soon</span>
</div>
{% else %}
<div class="static-thumb w-full h-full bg-cover bg-center" style="background-image: url('{{ game.image }}');"></div>
{% if game.video %}
<div class="video-container absolute inset-0">
<video class="w-full h-full object-cover" loop muted playsinline>
<source src="{{ game.video }}" type="video/mp4">
</video>
</div>
{% endif %}
{% if game.logo %}
<div class="absolute inset-x-0 bottom-0 pt-8 pb-2 px-2 flex items-end justify-center pointer-events-none" style="background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);">
<img src="{{ game.logo }}" alt="" class="max-w-[82%] max-h-[34%] object-contain">
</div>
{% else %}
<div class="absolute bottom-2 left-2 w-6 h-6 rounded {{ game.accent | accentBadge }} flex items-center justify-center shadow-sm">
<span class="material-symbols-outlined {{ game.accent | accentText }} text-[14px]">{{ game.icon }}</span>
</div>
{% endif %}
{% endif %}
</div>
<div class="flex flex-col leading-tight">
<h4 class="font-bold text-on-surface text-[13px] truncate">{{ game.title }}</h4>
<p class="text-secondary text-[11px]">{{ game.genre }}</p>
<p class="text-on-surface-variant font-medium text-[11px]">{{ game.price }}</p>
</div>
</div>
{% endfor %}
</div>
</div>
</main>
<script>
    document.querySelectorAll('.group').forEach(card => {
        const video = card.querySelector('video');
        if (video) {
            card.addEventListener('mouseenter', () => {
                video.currentTime = 0;
                video.play();
            });
            card.addEventListener('mouseleave', () => {
                video.pause();
            });
        }
    });
</script>
