---
layout: base.njk
title: MULTIVERSE | Game Library
activeNav: home
permalink: /
---
<main class="pt-36 pb-section_padding">
<div class="mx-auto px-gutter max-w-container_max_width">
{% if home.heading and (home.heading | trim) %}
<div class="mb-8">
<h1 class="font-display-lg text-display-lg text-on-surface mb-3">{{ home.heading }}</h1>
{% if home.subtext and (home.subtext | trim) %}
<p class="font-body-lg text-body-lg text-secondary max-w-2xl">{{ home.subtext }}</p>
{% endif %}
</div>
{% endif %}
<div class="game-grid">
{% for game in games %}
<div class="group flex flex-col gap-2 card-in" style="animation-delay: {{ loop.index0 * 80 }}ms;">
<div class="relative w-full aspect-[4/5] rounded-lg overflow-hidden bg-surface-container-high game-card-shadow game-card-frame transition-all duration-300" style="border-top: 3px solid {{ game.accent | accentHex }};">
{% if game.comingSoon or (not game.image and not game.video) %}
<div class="coming-soon-tile w-full h-full flex flex-col items-center justify-center gap-3" style="background: linear-gradient(145deg, {{ game.accent | accentHex }}22, {{ game.accent | accentHex }}0a);">
<span class="material-symbols-outlined text-[36px]" style="color: {{ game.accent | accentHex }}; font-variation-settings: 'FILL' 1;">{{ game.icon }}</span>
<span class="font-label-md text-[10px] tracking-widest uppercase" style="color: {{ game.accent | accentHex }};">Coming Soon</span>
</div>
{% else %}
{% if game.image %}
<div class="static-thumb w-full h-full bg-cover bg-center" style="background-image: url('{{ game.image }}');"></div>
{% if game.video %}
<div class="video-container absolute inset-0">
<video class="w-full h-full object-cover" loop muted playsinline>
<source src="{{ game.video }}" type="video/mp4">
</video>
</div>
{% endif %}
{% else %}
<video class="w-full h-full object-cover" loop muted playsinline>
<source src="{{ game.video }}" type="video/mp4">
</video>
{% endif %}
{% endif %}
</div>
<div class="flex flex-wrap items-center gap-2">
<div class="flex items-center gap-2 flex-1 min-w-[108px]">
{% if game.appIcon %}
<img src="{{ game.appIcon }}" alt="" class="game-app-icon w-11 h-11 rounded-[22%] object-cover shrink-0">
{% else %}
<div class="game-app-icon w-11 h-11 rounded-[22%] {{ game.accent | accentBadge }} flex items-center justify-center shrink-0">
<span class="material-symbols-outlined {{ game.accent | accentText }} text-[24px]">{{ game.icon }}</span>
</div>
{% endif %}
<div class="flex flex-col leading-tight min-w-0">
<h4 class="font-bold text-on-surface text-[13px] leading-snug line-clamp-2">{{ game.title }}</h4>
<p class="text-secondary text-[11px]">{{ game.genre }}</p>
<p class="text-on-surface-variant font-medium text-[11px]">{{ game.price }}</p>
</div>
</div>
{% if game.platforms and game.platforms.length %}
<div class="flex gap-1 shrink-0">
{% if "Google Play" in game.platforms %}
<span class="game-app-icon w-11 h-11 rounded-[22%] bg-surface-container-high text-on-surface-variant flex items-center justify-center p-2.5" title="Available on Google Play">
<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"/></svg>
</span>
{% endif %}
{% if "Steam" in game.platforms %}
<span class="game-app-icon w-11 h-11 rounded-[22%] bg-surface-container-high text-on-surface-variant flex items-center justify-center p-2.5" title="Available on Steam">
<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z"/></svg>
</span>
{% endif %}
</div>
{% endif %}
</div>
</div>
{% endfor %}
</div>
</div>
</main>
<script>
    // Game cards with both a cover image AND a video: show the cover as a
    // banner first, then swap over to the looping gameplay video after a
    // short delay, once the card is actually on screen. Cards with no cover
    // image (continuous-loop tiles) have nothing to show first, so those
    // just play right away. Either way, scrolling a card out of view pauses
    // its video (and, for the banner cards, resets back to the cover image)
    // so the whole sequence replays next time it scrolls back in — and so
    // the page isn't decoding video for cards no one is looking at.
    const BANNER_DELAY_MS = 5000;
    const pendingTimers = new WeakMap();

    const bannerCards = [];
    const plainVideos = [];
    document.querySelectorAll('.group').forEach((card) => {
        const container = card.querySelector('.video-container');
        const video = card.querySelector('video');
        if (!video) return;
        if (container) {
            bannerCards.push({ card, container, video });
        } else {
            plainVideos.push(video);
        }
    });

    const bannerObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            const card = entry.target;
            const video = card.querySelector('video');
            if (entry.isIntersecting) {
                const timer = setTimeout(() => {
                    card.classList.add('video-active');
                    video.currentTime = 0;
                    video.play().catch(() => {});
                }, BANNER_DELAY_MS);
                pendingTimers.set(card, timer);
            } else {
                clearTimeout(pendingTimers.get(card));
                pendingTimers.delete(card);
                card.classList.remove('video-active');
                video.pause();
                video.currentTime = 0;
            }
        });
    }, { threshold: 0.25 });

    bannerCards.forEach(({ card }) => bannerObserver.observe(card));

    const plainVideoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            const video = entry.target;
            if (entry.isIntersecting) {
                video.play().catch(() => {});
            } else {
                video.pause();
            }
        });
    }, { threshold: 0.25 });

    plainVideos.forEach((video) => plainVideoObserver.observe(video));
</script>
