<script>
(function () {
    // ----- Login dropdown -----
    var loginBtn = document.getElementById('login-toggle-btn');
    var loginDropdown = document.getElementById('login-dropdown');
    var loginChevron = document.getElementById('login-chevron');

    window.toggleLoginDropdown = function (e) {
        e.stopPropagation();
        var isOpen = loginDropdown.classList.toggle('open');
        if (loginChevron) loginChevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    };

    document.addEventListener('click', function (e) {
        if (loginDropdown && loginDropdown.classList.contains('open') &&
            !loginDropdown.contains(e.target) && !loginBtn.contains(e.target)) {
            loginDropdown.classList.remove('open');
            if (loginChevron) loginChevron.style.transform = 'rotate(0deg)';
        }
    });

    // ----- Mobile nav menu -----
    var mobileMenuBtn = document.getElementById('mobile-menu-btn');
    var mobileMenu = document.getElementById('mobile-menu');
    var mobileMenuIcon = document.getElementById('mobile-menu-icon');

    window.toggleMobileMenu = function (e) {
        e.stopPropagation();
        var isOpen = mobileMenu.classList.toggle('open');
        if (mobileMenuIcon) mobileMenuIcon.textContent = isOpen ? 'close' : 'menu';
    };

    document.addEventListener('click', function (e) {
        if (mobileMenu && mobileMenu.classList.contains('open') &&
            !mobileMenu.contains(e.target) && !mobileMenuBtn.contains(e.target)) {
            mobileMenu.classList.remove('open');
            if (mobileMenuIcon) mobileMenuIcon.textContent = 'menu';
        }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            if (loginDropdown) loginDropdown.classList.remove('open');
            if (loginChevron) loginChevron.style.transform = 'rotate(0deg)';
            var userDropdownEl = document.getElementById('user-dropdown');
            var userChevronEl = document.getElementById('user-chevron');
            if (userDropdownEl) userDropdownEl.classList.remove('open');
            if (userChevronEl) userChevronEl.style.transform = 'rotate(0deg)';
            if (mobileMenu) mobileMenu.classList.remove('open');
            if (mobileMenuIcon) mobileMenuIcon.textContent = 'menu';
            document.querySelectorAll('.modal-backdrop.open').forEach(closeModalEl);
        }
    });

    // ----- Modals -----
    window.openModal = function (id) {
        var modal = document.getElementById(id);
        if (!modal) return;
        modal.classList.add('open');
        document.body.style.overflow = 'hidden';
    };
    window.closeModal = function (id) {
        var modal = document.getElementById(id);
        if (modal) closeModalEl(modal);
    };
    function closeModalEl(modal) {
        modal.classList.remove('open');
        document.body.style.overflow = '';
    }

    // ----- Netlify AJAX form submit helper -----
    function submitNetlifyForm(form, onSuccess, onError) {
        var data = new URLSearchParams(new FormData(form)).toString();
        fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: data
        }).then(function (res) {
            if (res.ok) { onSuccess(); } else { onError(); }
        }).catch(function () { onError(); });
    }

    // ----- Contact form -----
    var contactForm = document.getElementById('contact-form');
    if (contactForm) {
        contactForm.addEventListener('submit', function (e) {
            e.preventDefault();
            document.getElementById('contact-error').classList.add('hidden');
            submitNetlifyForm(contactForm, function () {
                document.getElementById('contact-form-wrap').classList.add('hidden');
                document.getElementById('contact-success').classList.remove('hidden');
                contactForm.reset();
            }, function () {
                document.getElementById('contact-error').classList.remove('hidden');
            });
        });
    }

    // ----- Newsletter form -----
    var newsletterForm = document.getElementById('newsletter-form');
    if (newsletterForm) {
        newsletterForm.addEventListener('submit', function (e) {
            e.preventDefault();
            document.getElementById('newsletter-error').classList.add('hidden');
            submitNetlifyForm(newsletterForm, function () {
                document.getElementById('newsletter-form-wrap').classList.add('hidden');
                document.getElementById('newsletter-success').classList.remove('hidden');
                launchConfetti(document.getElementById('newsletter-confetti-zone'));
                newsletterForm.reset();
            }, function () {
                document.getElementById('newsletter-error').classList.remove('hidden');
            });
        });
    }

    // ----- Confetti burst -----
    function launchConfetti(container) {
        if (!container) return;
        var colors = ['#5ce06d', '#006e23', '#6e9fff', '#adc6ff', '#ffffff'];
        for (var i = 0; i < 24; i++) {
            var piece = document.createElement('span');
            piece.className = 'confetti-piece';
            piece.style.left = (Math.random() * 100) + '%';
            piece.style.top = (15 + Math.random() * 15) + '%';
            piece.style.background = colors[Math.floor(Math.random() * colors.length)];
            piece.style.animationDelay = (Math.random() * 0.3) + 's';
            piece.style.animationDuration = (0.8 + Math.random() * 0.6) + 's';
            container.appendChild(piece);
            (function (p) { setTimeout(function () { p.remove(); }, 1800); })(piece);
        }
    }

    // ----- Wire up "Register to Newsletter" buttons on any page -----
    document.querySelectorAll('[data-open-newsletter]').forEach(function (btn) {
        btn.addEventListener('click', function () { window.openModal('newsletter-modal'); });
    });
    // ----- Wire up "Contact Us" buttons on any page -----
    document.querySelectorAll('[data-open-contact]').forEach(function (btn) {
        btn.addEventListener('click', function () { window.openModal('contact-modal'); });
    });

    // ----- Close mobile menu when a link inside it is tapped -----
    if (mobileMenu) {
        mobileMenu.querySelectorAll('a').forEach(function (link) {
            link.addEventListener('click', function () {
                mobileMenu.classList.remove('open');
                if (mobileMenuIcon) mobileMenuIcon.textContent = 'menu';
            });
        });
    }
})();
</script>

<!-- ===== Shared cart logic (used by Shop and Pricing "Add to Cart" buttons) ===== -->
<script>
(function () {
    var CART_KEY = 'multiverse_verse_cart';

    function loadCart() {
        try {
            var raw = localStorage.getItem(CART_KEY);
            return raw ? JSON.parse(raw) : [];
        } catch (e) { return []; }
    }
    function saveCart(cart) {
        try { localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch (e) {}
    }

    var cart = loadCart();

    function formatDollars(cents) {
        return '$' + (cents / 100).toFixed(2);
    }

    function cartTotalCents() {
        return cart.reduce(function (sum, item) { return sum + item.priceCents * item.qty; }, 0);
    }
    function cartCount() {
        return cart.reduce(function (sum, item) { return sum + item.qty; }, 0);
    }

    function render() {
        var itemsWrap = document.getElementById('cart-items');
        var emptyState = document.getElementById('cart-empty-state');
        var footer = document.getElementById('cart-footer');
        var badge = document.getElementById('cart-fab-badge');
        var template = document.getElementById('cart-item-template');
        if (!itemsWrap || !template) return;

        itemsWrap.innerHTML = '';

        if (cart.length === 0) {
            itemsWrap.classList.add('hidden');
            footer.classList.add('hidden');
            emptyState.classList.remove('hidden');
        } else {
            itemsWrap.classList.remove('hidden');
            footer.classList.remove('hidden');
            emptyState.classList.add('hidden');

            cart.forEach(function (item) {
                var row = template.content.cloneNode(true);
                row.querySelector('.cart-row-icon').src = item.icon;
                row.querySelector('.cart-row-name').textContent = item.name;
                row.querySelector('.cart-row-unit-price').textContent = item.priceLabel + ' each';
                row.querySelector('.cart-row-qty').textContent = item.qty;
                row.querySelector('.qty-decrement').addEventListener('click', function () { changeQty(item.id, -1); });
                row.querySelector('.qty-increment').addEventListener('click', function () { changeQty(item.id, 1); });
                row.querySelector('.qty-remove').addEventListener('click', function () { removeItem(item.id); });
                itemsWrap.appendChild(row);
            });
        }

        document.getElementById('cart-total').textContent = formatDollars(cartTotalCents());

        var count = cartCount();
        badge.textContent = count;
        badge.classList.toggle('show', count > 0);

        saveCart(cart);
    }

    function addToCart(data) {
        var existing = cart.find(function (i) { return i.id === data.id; });
        if (existing) {
            existing.qty += 1;
        } else {
            cart.push({ id: data.id, name: data.name, priceCents: data.priceCents, priceLabel: data.priceLabel, icon: data.icon, qty: 1 });
        }
        render();
        window.openCart();
    }

    function changeQty(id, delta) {
        var item = cart.find(function (i) { return i.id === id; });
        if (!item) return;
        item.qty += delta;
        if (item.qty <= 0) {
            cart = cart.filter(function (i) { return i.id !== id; });
        }
        render();
    }

    function removeItem(id) {
        cart = cart.filter(function (i) { return i.id !== id; });
        render();
    }

    window.openCart = function () {
        var backdrop = document.getElementById('cart-drawer-backdrop');
        if (!backdrop) return;
        backdrop.classList.add('open');
        document.body.style.overflow = 'hidden';
    };
    window.closeCart = function () {
        var backdrop = document.getElementById('cart-drawer-backdrop');
        if (!backdrop) return;
        backdrop.classList.remove('open');
        document.body.style.overflow = '';
    };

    document.querySelectorAll('.add-to-cart-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            addToCart({
                id: btn.dataset.id,
                name: btn.dataset.name,
                priceCents: parseInt(btn.dataset.priceCents, 10),
                priceLabel: btn.dataset.priceLabel,
                icon: btn.dataset.icon
            });
        });
    });

    window.startCheckout = function () {
        if (cart.length === 0) return;
        var btn = document.getElementById('checkout-btn');
        var errorEl = document.getElementById('checkout-error');
        errorEl.classList.add('hidden');
        btn.disabled = true;
        btn.textContent = 'Redirecting…';

        fetch('/.netlify/functions/create-checkout-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                items: cart.map(function (i) { return { name: i.name, priceCents: i.priceCents, qty: i.qty }; })
            })
        }).then(function (res) {
            if (!res.ok) throw new Error('checkout failed');
            return res.json();
        }).then(function (data) {
            if (!data.url) throw new Error('no checkout url');
            window.location.href = data.url;
        }).catch(function () {
            btn.disabled = false;
            btn.textContent = 'Proceed to Payment';
            errorEl.classList.remove('hidden');
        });
    };

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') window.closeCart();
    });

    render();
})();
</script>

<!-- ===== Account login / sign-up (Firebase Authentication) ===== -->
<script src="https://www.gstatic.com/firebasejs/12.7.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/12.7.0/firebase-auth-compat.js"></script>
<script>
(function () {
    // If the Firebase SDK failed to load (blocked network, ad blocker, etc.),
    // bail out of auth setup quietly rather than throwing and breaking every
    // other script on the page (cart, modals, mobile nav all load separately
    // and should keep working either way).
    if (typeof firebase === 'undefined') {
        console.warn('Firebase SDK did not load — account login is unavailable right now.');
        return;
    }

    var firebaseConfig = {
        apiKey: "AIzaSyCovpxKjvK2SRLxdl3gOUjYxfxauB8lNdI",
        authDomain: "multiverse-games-b275f.firebaseapp.com",
        projectId: "multiverse-games-b275f",
        storageBucket: "multiverse-games-b275f.firebasestorage.app",
        messagingSenderId: "546833600839",
        appId: "1:546833600839:web:01df1805030c1ec5a1fc62",
        measurementId: "G-1S4LJJWGMT"
    };
    firebase.initializeApp(firebaseConfig);
    var auth = firebase.auth();
    var googleProvider = new firebase.auth.GoogleAuthProvider();

    var loginMenuWrap = document.getElementById('login-menu-wrap');
    var userMenuWrap = document.getElementById('user-menu-wrap');
    var userDropdown = document.getElementById('user-dropdown');
    var userChevron = document.getElementById('user-chevron');
    var userToggleBtn = document.getElementById('user-toggle-btn');
    var loginDropdownEl = document.getElementById('login-dropdown');
    var loginChevronEl = document.getElementById('login-chevron');

    function closeLoginDropdown() {
        if (loginDropdownEl) loginDropdownEl.classList.remove('open');
        if (loginChevronEl) loginChevronEl.style.transform = 'rotate(0deg)';
    }

    // ----- User account dropdown (shown once signed in) -----
    window.toggleUserDropdown = function (e) {
        e.stopPropagation();
        var isOpen = userDropdown.classList.toggle('open');
        if (userChevron) userChevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    };

    document.addEventListener('click', function (e) {
        if (userDropdown && userDropdown.classList.contains('open') &&
            !userDropdown.contains(e.target) && !userToggleBtn.contains(e.target)) {
            userDropdown.classList.remove('open');
            if (userChevron) userChevron.style.transform = 'rotate(0deg)';
        }
    });

    // ----- Reflect signed-in / signed-out state in the nav -----
    auth.onAuthStateChanged(function (user) {
        if (user) {
            loginMenuWrap.classList.add('hidden');
            userMenuWrap.classList.remove('hidden');

            var displayName = user.displayName || (user.email ? user.email.split('@')[0] : 'Account');
            document.getElementById('user-display-name').textContent = displayName;
            document.getElementById('user-email-display').textContent = user.email || '';

            var avatarImg = document.getElementById('user-avatar-img');
            var avatarInitial = document.getElementById('user-avatar-initial');
            if (user.photoURL) {
                avatarImg.src = user.photoURL;
                avatarImg.classList.remove('hidden');
                avatarInitial.classList.add('hidden');
            } else {
                avatarImg.classList.add('hidden');
                avatarInitial.classList.remove('hidden');
                avatarInitial.textContent = displayName.charAt(0).toUpperCase();
            }
        } else {
            loginMenuWrap.classList.remove('hidden');
            userMenuWrap.classList.add('hidden');
        }
    });

    document.getElementById('logout-btn').addEventListener('click', function () {
        auth.signOut();
        userDropdown.classList.remove('open');
        if (userChevron) userChevron.style.transform = 'rotate(0deg)';
    });

    // ----- Friendly error messages -----
    function authErrorMessage(err) {
        switch (err.code) {
            case 'auth/email-already-in-use': return 'An account with this email already exists — try signing in instead.';
            case 'auth/invalid-email': return "That email address doesn't look right.";
            case 'auth/weak-password': return 'Password should be at least 6 characters.';
            case 'auth/user-not-found':
            case 'auth/wrong-password':
            case 'auth/invalid-credential': return 'Incorrect email or password.';
            case 'auth/popup-closed-by-user':
            case 'auth/cancelled-popup-request': return '';
            default: return 'Something went wrong — please try again.';
        }
    }
    function showAuthError(err) {
        var msg = authErrorMessage(err);
        var errorEl = document.getElementById('auth-error');
        if (!msg) { errorEl.classList.add('hidden'); return; }
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
    }

    // ----- Google sign-in -----
    document.getElementById('google-signin-btn').addEventListener('click', function () {
        document.getElementById('auth-error').classList.add('hidden');
        auth.signInWithPopup(googleProvider).then(function () {
            closeLoginDropdown();
        }).catch(showAuthError);
    });

    // ----- Email/password sign in and sign up (one form, toggled mode) -----
    var isSignUpMode = false;
    var authTitle = document.getElementById('auth-modal-title');
    var authSubtitle = document.getElementById('auth-modal-subtitle');
    var authSubmitBtn = document.getElementById('auth-submit-btn');
    var authModeSwitch = document.getElementById('auth-mode-switch');
    var authModePromptText = document.getElementById('auth-mode-prompt-text');
    var authForm = document.getElementById('auth-form');

    function setAuthMode(signUp) {
        isSignUpMode = signUp;
        document.getElementById('auth-error').classList.add('hidden');
        if (signUp) {
            authTitle.textContent = 'Create Account';
            authSubtitle.textContent = 'Sign up to get started';
            authSubmitBtn.textContent = 'Sign Up';
            authModePromptText.textContent = 'Already have an account? ';
            authModeSwitch.textContent = 'Sign in';
        } else {
            authTitle.textContent = 'Welcome Back';
            authSubtitle.textContent = 'Sign in to your account';
            authSubmitBtn.textContent = 'Sign In';
            authModePromptText.textContent = "Don't have an account? ";
            authModeSwitch.textContent = 'Sign up';
        }
    }
    // The button itself is never recreated, so this listener only needs
    // attaching once — fixes a bug where rebuilding it via innerHTML on
    // every toggle detached the just-clicked element mid-click, which made
    // the document-level "click outside closes the dropdown" handler treat
    // the click as outside and immediately close the dropdown again.
    authModeSwitch.addEventListener('click', function () { setAuthMode(!isSignUpMode); });

    authForm.addEventListener('submit', function (e) {
        e.preventDefault();
        document.getElementById('auth-error').classList.add('hidden');
        var email = document.getElementById('auth-email').value;
        var password = document.getElementById('auth-password').value;
        var action = isSignUpMode
            ? auth.createUserWithEmailAndPassword(email, password)
            : auth.signInWithEmailAndPassword(email, password);
        action.then(function () {
            authForm.reset();
            closeLoginDropdown();
        }).catch(showAuthError);
    });
})();
</script>
</body></html>
