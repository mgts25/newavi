<!DOCTYPE html><html class="scroll-smooth" lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>{{ title }}</title>
<link rel="stylesheet" href="/css/style.css">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=Geist:wght@400;500;600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
</head>
<body class="bg-background text-on-surface font-body-md overflow-x-hidden flex flex-col min-h-screen">
<nav class="fixed top-0 w-full z-50 glass-nav bg-surface/80 shadow-sm">
<div class="flex justify-between items-center h-20 px-gutter mx-auto max-w-container_max_width">
<a href="/" class="font-display-lg font-extrabold text-primary tracking-tighter text-headline-md">MULTIVERSE</a>
<div class="hidden md:flex items-center gap-8">
<a class="font-label-md text-label-md {% if activeNav == 'about' %}text-primary border-b-2 border-primary pb-1{% else %}text-on-surface-variant hover:text-primary transition-colors duration-200{% endif %}" href="/about/">About</a>
<a class="font-label-md text-label-md {% if activeNav == 'careers' %}text-primary border-b-2 border-primary pb-1{% else %}text-on-surface-variant hover:text-primary transition-colors duration-200{% endif %}" href="/careers/">Careers</a>
<a class="font-label-md text-label-md {% if activeNav == 'pricing' %}text-primary border-b-2 border-primary pb-1{% else %}text-on-surface-variant hover:text-primary transition-colors duration-200{% endif %}" href="/pricing/">Pricing</a>
<a class="font-label-md text-label-md {% if activeNav == 'shop' %}text-primary border-b-2 border-primary pb-1{% else %}text-on-surface-variant hover:text-primary transition-colors duration-200{% endif %}" href="/shop/">Shop</a>
</div>
<div class="flex items-center gap-1">
<button type="button" id="mobile-menu-btn" onclick="toggleMobileMenu(event)" aria-label="Menu" class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-full hover:bg-surface-container-low transition-colors">
<span class="material-symbols-outlined" id="mobile-menu-icon">menu</span>
</button>
<div class="relative flex items-center">
<button type="button" id="login-toggle-btn" onclick="toggleLoginDropdown(event)" class="inline-flex items-center gap-1 font-label-md text-label-md text-on-surface-variant hover:text-primary hover:bg-surface-container-low transition-colors duration-200 px-4 py-2 rounded-full">
Login
<span class="material-symbols-outlined text-[18px] transition-transform duration-300" id="login-chevron">expand_more</span>
</button>
<div id="login-dropdown" class="login-dropdown absolute bg-surface-container-lowest rounded-xl shadow-[0px_16px_40px_rgba(0,0,0,0.14)] border border-outline-variant/30 p-6">
<div class="text-center mb-5">
<h3 class="font-headline-md text-headline-md text-on-surface mb-1">Welcome Back</h3>
<p class="text-secondary text-[12px]">Sign in to your account</p>
</div>
<button type="button" class="w-full flex items-center justify-center gap-2 bg-primary text-on-primary font-label-md text-label-md py-3 rounded-lg shadow-sm hover:bg-primary-container hover:text-on-primary-container transition-all duration-300 mb-4">
<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path>
<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path>
<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"></path>
<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 12-4.53z"></path>
</svg>
Login with Google
</button>
<div class="relative flex items-center py-2 mb-4">
<div class="flex-grow border-t border-outline-variant"></div>
<span class="flex-shrink mx-3 font-label-md text-[11px] text-on-surface-variant/50">or</span>
<div class="flex-grow border-t border-outline-variant"></div>
</div>
<form onsubmit="return false;" class="space-y-3">
<input class="w-full px-4 py-2.5 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 bg-surface-bright transition-all outline-none font-body-md text-[13px]" placeholder="Email" type="email">
<input class="w-full px-4 py-2.5 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 bg-surface-bright transition-all outline-none font-body-md text-[13px]" placeholder="Password" type="password">
<button type="submit" class="w-full py-2.5 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:bg-primary-container hover:text-on-primary-container transition-colors">Sign In</button>
</form>
<p class="text-center text-[11px] text-on-surface-variant/60 mt-4">Account login coming soon</p>
</div>
</div>
</div>
</div>
</nav>
<div id="mobile-menu" class="mobile-menu md:hidden">
<a href="/about/" class="block px-gutter py-4 font-label-md text-label-md border-b border-outline-variant/30 {% if activeNav == 'about' %}text-primary{% else %}text-on-surface-variant{% endif %}">About</a>
<a href="/careers/" class="block px-gutter py-4 font-label-md text-label-md border-b border-outline-variant/30 {% if activeNav == 'careers' %}text-primary{% else %}text-on-surface-variant{% endif %}">Careers</a>
<a href="/pricing/" class="block px-gutter py-4 font-label-md text-label-md border-b border-outline-variant/30 {% if activeNav == 'pricing' %}text-primary{% else %}text-on-surface-variant{% endif %}">Pricing</a>
<a href="/shop/" class="block px-gutter py-4 font-label-md text-label-md {% if activeNav == 'shop' %}text-primary{% else %}text-on-surface-variant{% endif %}">Shop</a>
</div>
{{ content | safe }}
<footer class="w-full py-section_padding bg-surface border-t border-outline-variant mt-auto">
<div class="flex flex-col items-center text-center gap-5 px-gutter max-w-container_max_width mx-auto">
<div class="text-sm font-bold text-primary tracking-wide">
MULTIVERSE
</div>
<nav class="flex flex-wrap justify-center gap-6">
<a class="font-label-md text-label-md text-secondary hover:text-primary transition-colors" href="/privacy/">Privacy Policy</a>
<a class="font-label-md text-label-md text-secondary hover:text-primary transition-colors" href="/terms/">Terms of Service</a>
<a class="font-label-md text-label-md text-secondary hover:text-primary transition-colors" href="/careers/">Careers</a>
<button type="button" onclick="openModal('newsletter-modal')" class="font-label-md text-label-md text-secondary hover:text-primary transition-colors">Newsletter</button>
<button type="button" onclick="openModal('contact-modal')" class="font-label-md text-label-md text-secondary hover:text-primary transition-colors">Contact</button>
</nav>
<p class="font-body-md text-body-md text-secondary opacity-80">
© {{ currentYear }} MULTIVERSE. All rights reserved.
</p>
</div>
</footer>

<div id="contact-modal" class="modal-backdrop" onclick="if(event.target===this) closeModal('contact-modal')">
<div class="modal-panel bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-md mx-4 p-8 relative" onclick="event.stopPropagation()">
<button type="button" onclick="closeModal('contact-modal')" aria-label="Close" class="absolute top-4 right-4 text-on-surface-variant hover:text-primary transition-colors">
<span class="material-symbols-outlined">close</span>
</button>
<div id="contact-form-wrap">
<h3 class="font-headline-md text-headline-md text-on-surface mb-1">Contact Us</h3>
<p class="text-secondary text-[13px] mb-6">We'll get back to you as soon as we can.</p>
<form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" id="contact-form" class="space-y-4">
<input type="hidden" name="form-name" value="contact">
<p class="hidden"><label>Don't fill this out: <input name="bot-field"></label></p>
<input type="email" name="email" required placeholder="Your email" class="w-full px-4 py-3 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 bg-surface-bright transition-all outline-none font-body-md text-[14px]">
<input type="text" name="subject" required placeholder="Subject" class="w-full px-4 py-3 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 bg-surface-bright transition-all outline-none font-body-md text-[14px]">
<textarea name="message" required placeholder="Your message" rows="4" class="w-full px-4 py-3 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 bg-surface-bright transition-all outline-none font-body-md text-[14px] resize-none"></textarea>
<button type="submit" class="w-full py-3 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:bg-primary-container hover:text-on-primary-container transition-colors">Send Message</button>
<p id="contact-error" class="hidden text-center text-[12px] text-error">Something went wrong — please try again or email us directly.</p>
</form>
</div>
<div id="contact-success" class="hidden text-center py-6">
<span class="material-symbols-outlined success-pop text-primary text-[56px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
<h3 class="font-headline-md text-headline-md text-on-surface mt-4 mb-2">Message Sent!</h3>
<p class="text-secondary text-[13px]">Thanks for reaching out — we'll be in touch soon.</p>
</div>
</div>
</div>

<div id="newsletter-modal" class="modal-backdrop" onclick="if(event.target===this) closeModal('newsletter-modal')">
<div class="modal-panel bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-md mx-4 p-8 relative overflow-hidden" onclick="event.stopPropagation()" id="newsletter-confetti-zone">
<button type="button" onclick="closeModal('newsletter-modal')" aria-label="Close" class="absolute top-4 right-4 text-on-surface-variant hover:text-primary transition-colors">
<span class="material-symbols-outlined">close</span>
</button>
<div id="newsletter-form-wrap" class="text-center">
<span class="material-symbols-outlined text-primary text-[40px] mb-2" style="font-variation-settings: 'FILL' 1;">mail</span>
<h3 class="font-headline-md text-headline-md text-on-surface mb-1">Stay in the Loop</h3>
<p class="text-secondary text-[13px] mb-6">Get the latest MULTIVERSE news straight to your inbox.</p>
<form name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field" id="newsletter-form" class="space-y-3">
<input type="hidden" name="form-name" value="newsletter">
<p class="hidden"><label>Don't fill this out: <input name="bot-field"></label></p>
<input type="email" name="email" required placeholder="you@email.com" class="w-full px-4 py-3 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 bg-surface-bright transition-all outline-none font-body-md text-[14px] text-center">
<button type="submit" class="w-full py-3 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:bg-primary-container hover:text-on-primary-container transition-colors">Subscribe</button>
<p id="newsletter-error" class="hidden text-center text-[12px] text-error">Something went wrong — please try again.</p>
</form>
</div>
<div id="newsletter-success" class="hidden text-center py-6">
<span class="material-symbols-outlined success-pop text-primary text-[56px]" style="font-variation-settings: 'FILL' 1;">celebration</span>
<h3 class="font-headline-md text-headline-md text-on-surface mt-4 mb-2">You're In!</h3>
<p class="text-secondary text-[13px]">Thanks for subscribing — watch your inbox.</p>
</div>
</div>
</div>

<script>
(function () {
    // ----- Login dropdown -----
    var loginBtn = document.getElementById('login-toggle-btn');
    var loginDropdown = document.getElementById('login-dropdown');
    var loginChevron = document.getElementById('login-chevron');

    window.toggleLoginDropdown = function (e) {
        e.stopPropagation();
        var isOpen = loginDropdown.classList.toggle('open');
        if (loginChevron) loginChevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    };

    document.addEventListener('click', function (e) {
        if (loginDropdown && loginDropdown.classList.contains('open') &&
            !loginDropdown.contains(e.target) && !loginBtn.contains(e.target)) {
            loginDropdown.classList.remove('open');
            if (loginChevron) loginChevron.style.transform = 'rotate(0deg)';
        }
    });

    // ----- Mobile nav menu -----
    var mobileMenuBtn = document.getElementById('mobile-menu-btn');
    var mobileMenu = document.getElementById('mobile-menu');
    var mobileMenuIcon = document.getElementById('mobile-menu-icon');

    window.toggleMobileMenu = function (e) {
        e.stopPropagation();
        var isOpen = mobileMenu.classList.toggle('open');
        if (mobileMenuIcon) mobileMenuIcon.textContent = isOpen ? 'close' : 'menu';
    };

    document.addEventListener('click', function (e) {
        if (mobileMenu && mobileMenu.classList.contains('open') &&
            !mobileMenu.contains(e.target) && !mobileMenuBtn.contains(e.target)) {
            mobileMenu.classList.remove('open');
            if (mobileMenuIcon) mobileMenuIcon.textContent = 'menu';
        }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            if (loginDropdown) loginDropdown.classList.remove('open');
            if (loginChevron) loginChevron.style.transform = 'rotate(0deg)';
            if (mobileMenu) mobileMenu.classList.remove('open');
            if (mobileMenuIcon) mobileMenuIcon.textContent = 'menu';
            document.querySelectorAll('.modal-backdrop.open').forEach(closeModalEl);
        }
    });

    // ----- Modals -----
    window.openModal = function (id) {
        var modal = document.getElementById(id);
        if (!modal) return;
        modal.classList.add('open');
        document.body.style.overflow = 'hidden';
    };
    window.closeModal = function (id) {
        var modal = document.getElementById(id);
        if (modal) closeModalEl(modal);
    };
    function closeModalEl(modal) {
        modal.classList.remove('open');
        document.body.style.overflow = '';
    }

    // ----- Netlify AJAX form submit helper -----
    function submitNetlifyForm(form, onSuccess, onError) {
        var data = new URLSearchParams(new FormData(form)).toString();
        fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: data
        }).then(function (res) {
            if (res.ok) { onSuccess(); } else { onError(); }
        }).catch(function () { onError(); });
    }

    // ----- Contact form -----
    var contactForm = document.getElementById('contact-form');
    if (contactForm) {
        contactForm.addEventListener('submit', function (e) {
            e.preventDefault();
            document.getElementById('contact-error').classList.add('hidden');
            submitNetlifyForm(contactForm, function () {
                document.getElementById('contact-form-wrap').classList.add('hidden');
                document.getElementById('contact-success').classList.remove('hidden');
                contactForm.reset();
            }, function () {
                document.getElementById('contact-error').classList.remove('hidden');
            });
        });
    }

    // ----- Newsletter form -----
    var newsletterForm = document.getElementById('newsletter-form');
    if (newsletterForm) {
        newsletterForm.addEventListener('submit', function (e) {
            e.preventDefault();
            document.getElementById('newsletter-error').classList.add('hidden');
            submitNetlifyForm(newsletterForm, function () {
                document.getElementById('newsletter-form-wrap').classList.add('hidden');
                document.getElementById('newsletter-success').classList.remove('hidden');
                launchConfetti(document.getElementById('newsletter-confetti-zone'));
                newsletterForm.reset();
            }, function () {
                document.getElementById('newsletter-error').classList.remove('hidden');
            });
        });
    }

    // ----- Confetti burst -----
    function launchConfetti(container) {
        if (!container) return;
        var colors = ['#5ce06d', '#006e23', '#6e9fff', '#adc6ff', '#ffffff'];
        for (var i = 0; i < 24; i++) {
            var piece = document.createElement('span');
            piece.className = 'confetti-piece';
            piece.style.left = (Math.random() * 100) + '%';
            piece.style.top = (15 + Math.random() * 15) + '%';
            piece.style.background = colors[Math.floor(Math.random() * colors.length)];
            piece.style.animationDelay = (Math.random() * 0.3) + 's';
            piece.style.animationDuration = (0.8 + Math.random() * 0.6) + 's';
            container.appendChild(piece);
            (function (p) { setTimeout(function () { p.remove(); }, 1800); })(piece);
        }
    }

    // ----- Wire up "Register to Newsletter" buttons on any page -----
    document.querySelectorAll('[data-open-newsletter]').forEach(function (btn) {
        btn.addEventListener('click', function () { window.openModal('newsletter-modal'); });
    });
    // ----- Wire up "Contact Us" buttons on any page -----
    document.querySelectorAll('[data-open-contact]').forEach(function (btn) {
        btn.addEventListener('click', function () { window.openModal('contact-modal'); });
    });

    // ----- Close mobile menu when a link inside it is tapped -----
    if (mobileMenu) {
        mobileMenu.querySelectorAll('a').forEach(function (link) {
            link.addEventListener('click', function () {
                mobileMenu.classList.remove('open');
                if (mobileMenuIcon) mobileMenuIcon.textContent = 'menu';
            });
        });
    }
})();
</script>
</body></html>
