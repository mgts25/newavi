<button type="button" onclick="closeModal('contact-modal')" aria-label="Close" class="absolute top-4 right-4 text-on-surface-variant hover:text-primary transition-colors">
<span class="material-symbols-outlined">close</span>
</button>
<div class="p-8">
<div id="contact-form-wrap">
<div class="w-14 h-14 rounded-full bg-tertiary/10 flex items-center justify-center mb-4">
<span class="material-symbols-outlined text-tertiary text-[26px]" style="font-variation-settings: 'FILL' 1;">forum</span>
</div>
<h3 class="font-headline-md text-headline-md text-on-surface mb-1">Contact Us</h3>
<p class="text-secondary text-[13px] mb-6">We'll get back to you as soon as we can.</p>
<form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" id="contact-form" class="space-y-4">
<input type="hidden" name="form-name" value="contact">
<p class="hidden"><label>Don't fill this out: <input name="bot-field"></label></p>
<input type="email" name="email" required placeholder="Your email" class="w-full px-4 py-3 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 bg-surface-bright transition-all outline-none font-body-md text-[14px]">
<input type="text" name="subject" required placeholder="Subject" class="w-full px-4 py-3 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 bg-surface-bright transition-all outline-none font-body-md text-[14px]">
<textarea name="message" required placeholder="Your message" rows="4" class="w-full px-4 py-3 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 bg-surface-bright transition-all outline-none font-body-md text-[14px] resize-none"></textarea>
<button type="submit" class="w-full py-3 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:bg-primary-container hover:text-on-primary-container transition-colors">Send Message</button>
<p id="contact-error" class="hidden text-center text-[12px] text-error">Something went wrong — please try again or email us directly.</p>
</form>
</div>
<div id="contact-success" class="hidden text-center py-6">
<span class="material-symbols-outlined success-pop text-primary text-[56px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
<h3 class="font-headline-md text-headline-md text-on-surface mt-4 mb-2">Message Sent!</h3>
<p class="text-secondary text-[13px]">Thanks for reaching out — we'll be in touch soon.</p>
</div>
</div>
</div>
</div>

