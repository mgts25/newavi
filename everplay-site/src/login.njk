<div class="mt-8 text-center">
<p class="font-body-md text-secondary">
                        Don't have an account?
                        <a class="text-primary font-bold hover:underline" href="#">Create Account</a>
</p>
</div>
</div>
<div class="mt-12 opacity-80 flex justify-center grayscale hover:grayscale-0 transition-all duration-500">
<div class="w-24 h-1 bg-primary/20 rounded-full"></div>
